{
  "name": "metar-taf",
  "version": "1.0.0",
  "description": "This package allows you to get TAF and METAR reports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kovnick/metar-taf"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/fetcher.integration.test.ts",
    "cover": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "keywords": [
    "metar",
    "taf",
    "aviation",
    "weather",
    "noaa",
    "airport"
  ],
  "author": "M.Kovalevskyi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
